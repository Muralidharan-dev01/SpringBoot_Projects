<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="mySpecification" class="car.example.injection.setter.Specification">
        <property name="make" value="BMW"></property>
        <property name="model" value="520d"></property>
    </bean>
    <bean id="myCar" class="car.example.injection.setter.Car">
       <!--Setter Injection-->
        <property name="specification" ref="mySpecification"></property>
    </bean>
</beans>